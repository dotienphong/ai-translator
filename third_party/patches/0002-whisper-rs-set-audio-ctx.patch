+    /// [WhisperState::lang_detect] calls (0 = model default).
+    ///
+    /// # Errors
+    /// [WhisperError::GenericError] with code -1 if `audio_ctx` is outside `[0, n_audio_ctx]` of the model.
+    pub fn set_audio_ctx(&mut self, audio_ctx: c_int) -> Result<(), WhisperError> {

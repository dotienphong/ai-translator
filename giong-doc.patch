+    expect(volume).toMatch(/value="70"/);
+    const speed = slider(markup, "tts-speed");
+    expect(speed).toMatch(/min="0.8"/);
+    expect(speed).toMatch(/max="1.3"/);
+    expect(speed).toMatch(/step="0.05"/);
+    expect(speed).toMatch(/value="1.05"/);

+    expect(buttons(markup).filter((b) => b.includes(viText["voice.preview"]))).toHaveLength(1);
+    expect(markup.indexOf(viText["voice.previewStop"])).toBeGreaterThan(markup.indexOf(viText["voice.lang.en"]));
+  });

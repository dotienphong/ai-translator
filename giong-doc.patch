+    expect(radio(markup, "voice-vi", "Mai Anh")).toContain('checked=""');
+    expect(radio(markup, "voice-vi", "")).not.toContain('checked=""');
+    expect(radio(markup, "voice-en", "")).toContain('checked=""');
+    // Một nút Nghe thử mỗi khối, cạnh giọng đang chọn.
+    expect(buttons(markup).filter((b) => b.includes(viText["voice.preview"]))).toHaveLength(2);
+  });
+
+  it("đang nghe thử khối nào thì nút của khối đó là Dừng", () => {
+    const markup = html(props({ previewing: "en" }));

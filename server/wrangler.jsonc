// Worker API công khai của license server (spec §6.8). Chỉ có MỘT môi trường, production (spec 2026-10-04): triển khai bằng
// `wrangler deploy`, không có `--env`. Worker admin cấu hình riêng ở wrangler.admin.jsonc.
// Test (vitest) đọc file này nhưng ghi đè ENVIRONMENT thành "test" và mọi secret thành giá trị giả (vitest.config.ts).
// Secret nhập bằng `wrangler secret put`, không bao giờ ghi vào file này (test Node quét cả chú thích): bắt buộc là đúng danh
// sách `secrets.required` ở cuối file (ba secret PayOS, khóa API và secret webhook của Creem, Resend, hai ô khóa ký, pepper, ba
// secret Zalo Bot của chat hỗ trợ: token, secret webhook, chat_id của chủ dự án);
// OPERATOR_EMAIL (email người vận hành nhận cảnh báo) là secret tùy chọn.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mt-license",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  // Tên miền riêng (spec 2026-10-06): Worker phục vụ api.aitranslator.io.vn. Giữ workers_dev tạm làm đường lui cho bản cài
  // cũ; tắt khi không còn bản cài nào dùng URL workers.dev.
  "workers_dev": true,
  "routes": [{ "pattern": "api.aitranslator.io.vn", "custom_domain": true }],
  "preview_urls": false,
  // Tắt invocation log (log đó lưu cả URL và query của request) và bỏ query khỏi URL trong log và trace (QĐ25).
  // Log JSON do code tự ghi vẫn giữ. Bật Workers Issues để có cảnh báo không phụ thuộc Resend (QĐ27).
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "invocation_logs": false }, "issues": { "enabled": true } },
  "vars": {
    // Luôn "production" ở đây. Giá trị "test" chỉ có trong vitest.config.ts (test/node/wrangler-config.test.mjs khóa điều này).
    "ENVIRONMENT": "production",
    "PAYOS_BASE_URL": "https://api-merchant.payos.vn",
    // Creem: cổng thanh toán quốc tế, thẻ, USD (spec 2026-10-14-creem-international-payment-design). Production cố định, không có
    // sandbox (test Node khóa giá trị). Hai vai tách nhau (src/deps.ts, creemFromEnv): XỬ LÝ (webhook, trạng thái, hoàn tiền và
    // tranh chấp của đơn Creem đã có) cần hai secret CREEM_API_KEY và CREEM_WEBHOOK_SECRET; BÁN (tạo phiên USD mới) cần thêm
    // CREEM_PRODUCT_IDS: mã sản phẩm Creem (prod_…) của ba gói, tạo ở dashboard Creem theo docs/release/phat-hanh.md. Chỉ có hai
    // dạng (test Node khóa): cả ba rỗng, hay cả ba prod_… khác nhau. Rỗng (chưa bán thẻ, hay tắt bán thẻ khẩn cấp): GET /v1/plans
    // không trả giá USD, POST /v1/checkout với currency USD trả 503, nhưng webhook Creem và đơn Creem đang chờ vẫn được xử lý.
    "CREEM_BASE_URL": "https://api.creem.io",
    "CREEM_PRODUCT_IDS": { "monthly": "prod_57yUG34lD35XDVFLLGA6nE", "six_months": "prod_4KnLuBCX1uqnJTEjL9utdD", "yearly": "prod_3tLlmFlWNKMR6xQonTQ1Wb" },
    // Tên miền gửi mail.aitranslator.io.vn đã xác thực ở Resend (SPF, DKIM); khách trả lời thư thì về EMAIL_REPLY_TO.
    "EMAIL_FROM": "AI Translator <no-reply@mail.aitranslator.io.vn>",
    "EMAIL_REPLY_TO": "support@aitranslator.io.vn",
    // Giá chính thức (spec 2026-10-07 §2.1; thay bốn gói chốt 2026-10-01). six_months thêm theo spec 2026-10-13 §1:
    // 100 giờ mỗi chu kỳ 30 ngày, 180 ngày mỗi đơn. Thứ tự các gói là thứ tự trong màn hình Nâng cấp (theo thời hạn).
    // Giá USD (cent, bán qua Creem) thêm theo spec 2026-10-14 D2: giữ tỉ lệ giá mỗi ngày giữa các gói gần bảng VND (sai số 3%,
    // test/node/wrangler-config.test.mjs), để luật đổi gói cho kết quả gần nhau dù khách trả bằng loại tiền nào.
    // Không hạ hạn mức của một gói đang bán (spec §6.8, QĐ17): token lấy hạn mức từ bảng hiện hành, nên hạ ở đây là
    // hạ luôn hạn mức của khách đã trả tiền. Muốn bán hạn mức thấp hơn thì thêm gói mới (sửa src/plans.ts và app).
    "PLANS": {
      "monthly": { "quota_minutes_per_cycle": 3000, "days_per_order": 30, "prices": { "VND": 50000, "USD": 399 } },
      "six_months": { "quota_minutes_per_cycle": 6000, "days_per_order": 180, "prices": { "VND": 269000, "USD": 2199 } },
      "yearly": { "quota_minutes_per_cycle": null, "days_per_order": 365, "prices": { "VND": 500000, "USD": 3999 } }
    },
    // Số ngày dùng thử Free của mỗi máy (spec 2026-10-07 §3.1). Đổi chỉ áp cho máy đăng ký sau đó.
    "TRIAL_DAYS": 10,
    // Ô khóa đang ký token: secret TOKEN_SIGNING_KEY_A hay _B (QĐ29). Ô kia là khóa dự phòng.
    // Đổi khóa: đặt sang ô kia rồi deploy (Phụ lục A); giá trị khóa không đi qua máy người vận hành.
    "TOKEN_SIGNING_SLOT": "a"
  },
  "secrets": {
    "required": ["PAYOS_CLIENT_ID", "PAYOS_API_KEY", "PAYOS_CHECKSUM_KEY", "CREEM_API_KEY", "CREEM_WEBHOOK_SECRET", "RESEND_API_KEY", "TOKEN_SIGNING_KEY_A", "TOKEN_SIGNING_KEY_B", "RATE_LIMIT_PEPPER", "ZALO_BOT_TOKEN", "ZALO_WEBHOOK_SECRET", "ZALO_OWNER_CHAT_ID"]
  },
  "d1_databases": [
    // database_id: thay bằng ID do `wrangler d1 create mt-license-production` in ra (Task 21).
    { "binding": "DB", "database_name": "mt-license-production", "database_id": "047c4ba4-4ad2-4ece-937c-2d91eafe2445" }
  ],
  // Chat hỗ trợ (spec 2026-10-22 §2.2): chặn hỏi tin mới quá nhanh mà không ghi D1 (bảng rate_limits tốn một lần ghi mỗi request).
  // Khóa là id cuộc chat; khách hỏi mỗi 3 giây nên 60 lần mỗi 60 giây còn dư cho vài tab. namespace_id là số tự chọn, duy nhất
  // trong tài khoản Cloudflare (tài khoản dùng chung với dự án khác: đừng đổi sang số nhỏ dễ trùng).
  "ratelimits": [{ "name": "SUPPORT_POLL_LIMITER", "namespace_id": "20261022", "simple": { "limit": 60, "period": 60 } }],
  "triggers": { "crons": ["*/5 * * * *"] }
}

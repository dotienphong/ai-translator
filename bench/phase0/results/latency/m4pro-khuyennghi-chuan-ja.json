      "end_ms": 11904,
      "audio_ms": 5152,
      "closed_at_ms": 12234.355125,
      "asr_started_at_ms": 12234.390875000001,
      "asr_done_at_ms": 12460.079167,
      "lid_ms": 2.568625,
      "asr_ms": 221.40242,
      "lang": "ja",
      "lang_prob": 0.9995844,
      "text": "スペイン人たちの植民地時代が始まりそれが3世紀続きことになった。",
      "no_speech_prob": 5.6228533e-12,
      "merged_segments": 1,
      "translated_source": "スペイン人たちの植民地時代が始まりそれが3世紀続きことになった。",
      "src_tokens": 24,
      "max_tokens": 128,
      "mt_started_at_ms": 12460.097458,
      "mt_first_at_ms": 12501.96187255078,
      "mt_done_at_ms": 12837.940083,
      "translation": "Thời kỳ thuộc địa của người Tây Ban Nha bắt đầu, và thời kỳ này kéo dài khoảng 3 thế kỷ.",
      "finish_reason": "stop",
      "shown_at_ms": 12837.940083,
      "first_shown_at_ms": 12501.96187255078,
      "skipped": null
    },
    {
      "id": 2,
      "start_ms": 13504,
      "end_ms": 19264,
      "audio_ms": 6208,
      "closed_at_ms": 19594.113125,
      "asr_started_at_ms": 19594.131292000002,
      "asr_done_at_ms": 19843.748042000003,
      "lid_ms": 2.487625,
      "asr_ms": 246.01392,
      "lang": "ja",
      "lang_prob": 0.9996338,
      "text": "何千年も前にアリスタルコスという学者が、太陽系は太陽の周りを異動していると言いました。",
      "no_speech_prob": 6.3729013e-12,
      "merged_segments": 1,
      "translated_source": "何千年も前にアリスタルコスという学者が、太陽系は太陽の周りを異動していると言いました。",
      "src_tokens": 33,
      "max_tokens": 164,
      "mt_started_at_ms": 19843.767166999998,
      "mt_first_at_ms": 19902.755638908202,
      "mt_done_at_ms": 20239.079583,
      "translation": "Cách đây hàng nghìn năm, nhà khoa học Aristarchus đã khẳng định rằng hệ Mặt Trời được quay quanh Mặt Trời.",
      "finish_reason": "stop",
      "shown_at_ms": 20239.079583,
      "first_shown_at_ms": 19902.755638908202,
      "skipped": null
    },
    {
      "id": 3,
      "start_ms": 20768,
      "end_ms": 25696,
      "audio_ms": 5376,
      "closed_at_ms": 26023.716042,
      "asr_started_at_ms": 26023.730708,
      "asr_done_at_ms": 26258.510042,
      "lid_ms": 2.626875,
      "asr_ms": 231.29697,
      "lang": "ja",
      "lang_prob": 0.99962544,
      "text": "両替はスタンレイにあるトーナ唯一の銀行FICウエストの向かいでできます。",
      "no_speech_prob": 8.131456e-12,
      "merged_segments": 1,
      "translated_source": "両替はスタンレイにあるトーナ唯一の銀行FICウエストの向かいでできます。",
      "src_tokens": 28,
      "max_tokens": 144,
      "mt_started_at_ms": 26258.524250000002,
      "mt_first_at_ms": 26306.51709032422,
      "mt_done_at_ms": 26583.212708000003,
      "translation": "Có thể đổi tiền tại ngân hàng FIC West duy nhất ở Staley, nằm đối diện với Torna.",
      "finish_reason": "stop",
      "shown_at_ms": 26583.212708000003,
      "first_shown_at_ms": 26306.51709032422,
      "skipped": null
    },
    {

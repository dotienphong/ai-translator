    },
    {
      "id": 1,
      "start_ms": 7200,
      "end_ms": 11904,
      "audio_ms": 5152,
      "closed_at_ms": 12226.053125,
      "asr_started_at_ms": 12226.073250000001,
      "asr_done_at_ms": 12401.869625,
      "lid_ms": 4.996417,
      "asr_ms": 169.7107,
      "lang": "ja",
      "lang_prob": 0.9966865,
      "text": "スペイン人たちの食民地時代が始まり、それが賛成期続きことになった。",
      "no_speech_prob": 0.023933431,
      "merged_segments": 1,
      "translated_source": "スペイン人たちの食民地時代が始まり、それが賛成期続きことになった。",
      "src_tokens": 26,
      "max_tokens": 136,
      "mt_started_at_ms": 12401.885042,
      "mt_first_at_ms": 12439.604853515626,
      "mt_done_at_ms": 12741.473750000001,
      "translation": "Thời kỳ người Tây Ban Nha trở thành những người chăn nuôi gia súc bắt đầu, và điều này tiếp tục diễn ra trong thời kỳ hòa bình.",
      "finish_reason": "stop",
      "shown_at_ms": 12741.473750000001,
      "first_shown_at_ms": 12439.604853515626,
      "skipped": null
    },
    {
      "id": 2,
      "start_ms": 13504,
      "end_ms": 19264,
      "audio_ms": 6208,
      "closed_at_ms": 19591.107209,
      "asr_started_at_ms": 19591.145125,
      "asr_done_at_ms": 19768.209542,
      "lid_ms": 4.037542,
      "asr_ms": 171.93495,
      "lang": "ja",
      "lang_prob": 0.9989598,
      "text": "何千年も前にアリスタルコスという学者が太陽系は太陽の周りを移動しると言いました",
      "no_speech_prob": 0.0036682298,
      "merged_segments": 1,
      "translated_source": "何千年も前にアリスタルコスという学者が太陽系は太陽の周りを移動しると言いました",
      "src_tokens": 31,
      "max_tokens": 156,
      "mt_started_at_ms": 19768.219292,
      "mt_first_at_ms": 19805.62742981738,
      "mt_done_at_ms": 20024.942417,
      "translation": "Cách đây hàng nghìn năm, nhà khoa học Aristarchus đã nói rằng hệ mặt trời di chuyển quanh Mặt Trời.",
      "finish_reason": "stop",
      "shown_at_ms": 20024.942417,
      "first_shown_at_ms": 19805.62742981738,
      "skipped": null
    },
    {
      "id": 3,
      "start_ms": 20768,
      "end_ms": 25696,
      "audio_ms": 5376,
      "closed_at_ms": 26022.772875000002,
      "asr_started_at_ms": 26022.799042,
      "asr_done_at_ms": 26168.646334,
      "lid_ms": 3.300583,
      "asr_ms": 141.21288,
      "lang": "ja",
      "lang_prob": 0.9978968,
      "text": "両外はスタンレイにある東南唯一の銀行FIC Westの向かいできます",
      "no_speech_prob": 0.03173712,
      "merged_segments": 1,
      "translated_source": "両外はスタンレイにある東南唯一の銀行FIC Westの向かいできます",
      "src_tokens": 23,
      "max_tokens": 124,
      "mt_started_at_ms": 26168.658667,
      "mt_first_at_ms": 26208.992450447266,
      "mt_done_at_ms": 26436.320667,
      "translation": "Cả hai bên có thể đi qua đối diện với FIC West – ngân hàng duy nhất ở phía đông nam tại St. Mary.",
      "finish_reason": "stop",
      "shown_at_ms": 26436.320667,
      "first_shown_at_ms": 26208.992450447266,
      "skipped": null
    },
    {

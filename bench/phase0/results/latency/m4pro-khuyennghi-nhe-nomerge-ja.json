      "mt_started_at_ms": 12395.794166,
      "mt_first_at_ms": 12432.325978515624,
      "mt_done_at_ms": 12755.3355,
      "translation": "Thời kỳ người Tây Ban Nha trở thành những người chăn nuôi gia súc bắt đầu, và điều này tiếp tục diễn ra trong thời kỳ hòa bình.",
      "finish_reason": "stop",
      "shown_at_ms": 12755.3355,
      "first_shown_at_ms": 12432.325978515624,
      "skipped": null
    },
    {
      "id": 2,
      "start_ms": 13504,
      "end_ms": 19264,
      "audio_ms": 6208,
      "closed_at_ms": 19586.4135,
      "asr_started_at_ms": 19586.444708,
      "asr_done_at_ms": 19788.652458,
      "lid_ms": 5.164625,
      "asr_ms": 194.99887,
      "lang": "ja",
      "lang_prob": 0.9989598,
      "text": "何千年も前にアリスタルコスという学者が太陽系は太陽の周りを移動しると言いました",
      "no_speech_prob": 0.0036682298,
      "merged_segments": 1,
      "translated_source": "何千年も前にアリスタルコスという学者が太陽系は太陽の周りを移動しると言いました",
      "src_tokens": 31,
      "max_tokens": 156,
      "mt_started_at_ms": 19788.662500000002,
      "mt_first_at_ms": 19822.370447021487,
      "mt_done_at_ms": 20044.437250000003,
      "translation": "Cách đây hàng nghìn năm, nhà khoa học Aristarchus đã nói rằng hệ mặt trời di chuyển quanh Mặt Trời.",
      "finish_reason": "stop",
      "shown_at_ms": 20044.437250000003,
      "first_shown_at_ms": 19822.370447021487,
      "skipped": null
    },
    {

      "asr_started_at_ms": 12226.5918,
      "asr_done_at_ms": 13011.635999999999,
      "lid_ms": 6.1057,
      "asr_ms": 776.84827,
      "lang": "ja",
      "lang_prob": 0.9995029,
      "text": "スペイン人たちの植民地時代が始まりそれが3世紀続きことになった",
      "no_speech_prob": 5.6573734e-12,
      "avg_logprob": -0.01530021,
      "vad_mean_prob": 0.9697911,
      "merged_segments": 1,
      "translated_source": "スペイン人たちの植民地時代が始まりそれが3世紀続きことになった",
      "src_tokens": 23,
      "max_tokens": 124,
      "mt_started_at_ms": 13011.649800000001,
      "mt_first_at_ms": 13414.686815234374,
      "mt_done_at_ms": 15495.306199999999,
      "translation": "Thời kỳ thuộc địa của người Tây Ban Nha bắt đầu, và thời kỳ này kéo dài khoảng 3 thế kỷ.",
      "finish_reason": "stop",
      "shown_at_ms": 15495.306199999999,
      "first_shown_at_ms": 13414.686815234374,
      "skipped": null
    },
    {
      "id": 2,
      "start_ms": 13504,
      "end_ms": 19264,
      "audio_ms": 6208,
      "closed_at_ms": 19585.8659,
      "asr_started_at_ms": 19585.9183,
      "asr_done_at_ms": 20425.609099999998,
      "lid_ms": 6.3315997,
      "asr_ms": 831.7523,
      "lang": "ja",
      "lang_prob": 0.99947244,
      "text": "何千年も前にアリスタルコスという学者が太陽系は太陽の周りを異動していると言いました。",
      "no_speech_prob": 5.8578108e-12,
      "avg_logprob": -0.08341258,
      "vad_mean_prob": 0.9956296,
      "merged_segments": 1,
      "translated_source": "何千年も前にアリスタルコスという学者が太陽系は太陽の周りを異動していると言いました。",
      "src_tokens": 32,
      "max_tokens": 160,
      "mt_started_at_ms": 20425.6217,
      "mt_first_at_ms": 20806.4516796875,
      "mt_done_at_ms": 22888.7925,
      "translation": "Cách đây hàng nghìn năm, nhà khoa học Aristarchus đã khẳng định rằng hệ Mặt Trời được quay quanh Mặt Trời.",
      "finish_reason": "stop",
      "shown_at_ms": 22888.7925,
      "first_shown_at_ms": 20806.4516796875,
      "skipped": null
    },
    {
      "id": 3,
      "start_ms": 20768,
      "end_ms": 25696,
      "audio_ms": 5376,
      "closed_at_ms": 26018.284600000003,
      "asr_started_at_ms": 26018.3345,
      "asr_done_at_ms": 26867.8445,
      "lid_ms": 5.7534,
      "asr_ms": 842.01544,
      "lang": "ja",
      "lang_prob": 0.99959654,
      "text": "両替はスタンレイにある東南唯一の銀行FICウエストの向かいでできます。",
      "no_speech_prob": 4.056989e-12,
      "avg_logprob": -0.1615957,
      "vad_mean_prob": 0.99551815,
      "merged_segments": 1,
      "translated_source": "両替はスタンレイにある東南唯一の銀行FICウエストの向かいでできます。",
      "src_tokens": 27,
      "max_tokens": 140,
      "mt_started_at_ms": 26867.9601,
      "mt_first_at_ms": 27272.096127734374,
      "mt_done_at_ms": 30130.3952,
      "translation": "Có thể đổi tiền tại ngân hàng FIC West, đây là ngân hàng duy nhất ở khu vực Đông Nam của St. Laurence. Ngân hàng này nằm đối diện với FIC West.",
      "finish_reason": "stop",
      "shown_at_ms": 30130.3952,
      "first_shown_at_ms": 27272.096127734374,
      "skipped": null
    },
    {
      "id": 4,
      "start_ms": 26432,
      "end_ms": 33216,
      "audio_ms": 7008,
      "closed_at_ms": 34434.6973,
      "asr_started_at_ms": 34434.755699999994,
      "asr_done_at_ms": 35311.7065,
      "lid_ms": 6.6073003,
      "asr_ms": 867.7086,
      "lang": "ja",
      "lang_prob": 0.9995554,
      "text": "ゾウやキリンなど一部の動物は車に近寄ってくる傾向があるので標準的な機器を利用すれば発生",
      "no_speech_prob": 8.209013e-12,
      "avg_logprob": -0.056052722,
      "vad_mean_prob": 0.9932581,
      "merged_segments": 1,
      "translated_source": "ゾウやキリンなど一部の動物は車に近寄ってくる傾向があるので標準的な機器を利用すれば発生",
      "src_tokens": 34,
      "max_tokens": 168,
      "mt_started_at_ms": 35311.810600000004,
      "mt_first_at_ms": 36274.94892539063,
      "mt_done_at_ms": 39348.3979,
      "translation": "Một số loài động vật như voi và tinh tinh có xu hướng tiếp cận xe. Vì vậy, nếu sử dụng các thiết bị tiêu chuẩn, thì tình trạng này sẽ không xảy ra.",
      "finish_reason": "stop",
      "shown_at_ms": 39348.3979,
      "first_shown_at_ms": 36274.94892539063,
      "skipped": null
    },
    {
      "id": 5,
